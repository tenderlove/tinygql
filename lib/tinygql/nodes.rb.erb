module TinyGQL
  autoload :InspectVisitor, "tinygql/inspect_visitor"

  module Nodes
    class Node
      include Enumerable

      # `start` is the start position of this node in the source document
      attr_reader :start

      # Nodes are frozen once they're built, so a parsed document can be
      # cached and shared.  Subclasses set their fields before calling this.
      # The lexer freezes token values and the parser freezes lists, so the
      # fields are frozen too
      def initialize start
        @start = start
        freeze
      end

      # Return the line of this node given `doc`
      def line doc
        doc[0, @start].count("\n") + 1
      end

<%- nodes.each do |node| -%>
      def <%= node.human_name %>?; false; end
<%- end -%>
      # Returns a tree-shaped string representation of this node and its
      # children.
      def inspect
        InspectVisitor.compose(self)
      end

      def each(&blk)
        yield self
        children.each { |v| v.each(&blk) }
      end
    end

<%- nodes.each do |node| -%>
    class <%= node.name %> < <%= node.parent ? node.parent : "Node" %>
      <%- if node.fields.any? -%>
      attr_reader <%= node.fields.map { |v| ":" + v.name }.join(", ") %>

      def initialize <%= (["pos"] + node.fields.map(&:name)).join(", ") %>
        <%- node.fields.each do |field| -%>
        @<%= field.name %> = <%= field.name %>
        <%- end -%>
        super(pos)
      end
      <%- end -%>

      def accept viz
        viz.handle_<%= node.human_name %> self
      end

      def fold viz, seed
        viz.handle_<%= node.human_name %> self, seed
      end

      def <%= node.human_name %>?; true; end

      <%- if node.has_children? -%>
      def children
        <%= node.children %>
      end
      <%- end -%>
    end
<%- end -%>
  end
end
