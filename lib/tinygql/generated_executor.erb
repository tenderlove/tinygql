
# Output types, mapped to branches in Executor#complete_named
OUTPUT_TYPES = {
<%- output_types.each_with_index do |type, i| -%>
  <%= lit type.name %> => <%= i %>,
<%- end -%>
}.freeze #: Hash[String, Integer]
<%- output_enums.each do |enum| -%>

<%= enum_constant enum.name %> = {
<%- enum.values.each_key do |value| -%>
  <%= lit value %> => true,
<%- end -%>
}.freeze #: Hash[String, true]
<%- end -%>
<%- object_types.each do |type| -%>

<%= execute_fields_constant type.name %> = {
<%- selectable_fields(type).each_with_index do |field, i| -%>
  <%= lit field.name %> => <%= i %>,
<%- end -%>
}.freeze #: Hash[String, Integer]
<%- end -%>

<%- arguments_fields = object_types.flat_map { |type| resolved_fields(type).filter_map { |field| [type, field] unless field.arguments.empty? } } -%>
<%- unless arguments_fields.empty? -%>

# Field arguments, frozen, with a reader for each argument.  Missing
# arguments without defaults are nil
module Arguments
<%- arguments_fields.each_with_index do |(type, field), i| -%>
<%- if i > 0 -%>

<%- end -%>
<%= value_class arguments_class_name(type.name, field.name), field.arguments, "  " %>
<%- end -%>
end
<%- end -%>

# Introspection results for this schema, which __schema and __type
# return.  See TinyGQL::Introspection
module Introspection
  Schema = TinyGQL::Introspection::Schema #: singleton(TinyGQL::Introspection::Schema)
  Type = TinyGQL::Introspection::Type #: singleton(TinyGQL::Introspection::Type)
  WrappingType = TinyGQL::Introspection::WrappingType #: singleton(TinyGQL::Introspection::WrappingType)
  Field = TinyGQL::Introspection::Field #: singleton(TinyGQL::Introspection::Field)
  InputValue = TinyGQL::Introspection::InputValue #: singleton(TinyGQL::Introspection::InputValue)
  EnumValue = TinyGQL::Introspection::EnumValue #: singleton(TinyGQL::Introspection::EnumValue)
  Directive = TinyGQL::Introspection::Directive #: singleton(TinyGQL::Introspection::Directive)
  EMPTY = [].freeze #: Array[untyped]

<%- schema.types.each_value do |type| -%>
  <%= introspection_variable type.name %> = <%= introspection_type type %>
<%- end -%>
<%- defines = schema.types.each_value.map { introspection_define _1, "  " } -%>
<%- directives = schema.directives.each_value.map { introspection_directive _1, "    " } -%>

<%- @introspection_wrappers.each_value do |name, kind, inner| -%>
  <%= name %> = WrappingType.new(<%= lit kind %>, <%= inner %>)
<%- end -%>

<%- defines.each do |define| -%>
  <%= define %>
<%- end -%>

  # Types by name
  TYPES = {
<%- schema.types.each_key do |name| -%>
    <%= lit name %> => <%= introspection_variable name %>,
<%- end -%>
  }.freeze #: Hash[String, TinyGQL::Introspection::Type]

  DIRECTIVES = [
<%- directives.each do |directive| -%>
    <%= directive %>,
<%- end -%>
  ].freeze #: Array[TinyGQL::Introspection::Directive]

<%- roots = %w{ query mutation subscription }.map { |op| schema.roots[op] ? introspection_variable(schema.roots[op]) : "nil" } -%>
  SCHEMA = Schema.new(<%= lit_or_nil schema.description %>, TYPES.values, <%= roots.join(", ") %>, DIRECTIVES) #: TinyGQL::Introspection::Schema
end

# Resolves fields.  Each object type field has a method that calls the
# field's name on the object, and each interface and union has a method
# that raises NotImplementedError.  Introspection objects take their
# fields' arguments, and __schema and __type return the Introspection
# module's objects, so overriding them can turn introspection off.
# Subclass this and pass an instance to `execute` with `resolvers:`
class Resolvers
<%- resolver_count = 0 -%>
<%- object_types.each do |type| -%>
<%- resolved_fields(type).each do |field| -%>
<%- if (resolver_count += 1) > 1 -%>

<%- end -%>
  #: (untyped, <%= field.arguments.empty? ? "nil" : arguments_class(type.name, field.name) %>, untyped) -> untyped
  def <%= resolver_method type.name, field.name %> obj, args, context
<%- if field.equal?(SCHEMA_FIELD) -%>
    Introspection::SCHEMA
<%- elsif field.equal?(TYPE_FIELD) -%>
    Introspection::TYPES[args.name]
<%- elsif introspection_type?(type) && !field.arguments.empty? -%>
    obj.<%= field.name %>(<%= field.arguments.map { "args.#{_1.name}" }.join(", ") %>)
<%- else -%>
    obj.<%= field.name %>
<%- end -%>
  end
<%- end -%>
<%- end -%>
<%- abstract_types.each do |type| -%>

  # The name of the object type of `obj`, one of <%= type.name %>'s possible types
  #: (untyped, untyped) -> String
  def resolve_type_<%= type.name %> obj, context
    raise NotImplementedError, "#{self.class}#resolve_type_<%= type.name %> is not implemented"
  end
<%- end -%>
end

# Executes operations.  See TinyGQL::Executor
class Executor < TinyGQL::Executor
  private

  #: (String?, untyped, Array[TinyGQL::Nodes::OperationDefinition]) -> void
  def execute_operation type, root, nodes
    case type
    when nil, "query" then <%= execute_method schema.roots["query"] %> root, nodes, nil
<%- if schema.roots["mutation"] -%>
    when "mutation" then <%= execute_method schema.roots["mutation"] %> root, nodes, nil
<%- end -%>
    else
      raise TinyGQL::Inputs::Error, "#{type} operations aren't supported"
    end
  end

  # Whether a fragment on `condition` applies to an object of `type`
  #: (String, String) -> bool
  def fragment_applies? condition, type
    return true if condition == type
    possible = ABSTRACT_POSSIBLE_TYPES[condition]
    bit = OBJECT_BITS[type]
    possible && bit ? possible[bit] == 1 : false
  end

  # Writes a value of the named type `type`.  Objects get a position in
  # the response, for errors in Lazies under them
  #: (String, Array[TinyGQL::Nodes::Field], untyped, path?, String | Integer, bool) -> void
  def complete_named type, nodes, value, path, key, nullable
    case OUTPUT_TYPES[type]
<%- output_types.each_with_index do |type, i| -%>
<%- case type.kind -%>
<%- when :scalar -%>
<%- if %w[String ID].include?(type.name) -%>
    when <%= i %>
      value = @scalars.coerce_result_<%= type.name %>(value)
      if String === value && !JSON_ESCAPE.match?(value) && value.valid_encoding? && (value.encoding == Encoding::UTF_8 || value.ascii_only?)
        @buf << '"' << value << '"'
      else
        complete_scalar(value, nodes, nullable)
      end
<%- else -%>
    when <%= i %> then complete_scalar @scalars.coerce_result_<%= type.name %>(value), nodes, nullable
<%- end -%>
<%- when :enum -%>
    when <%= i %> then @buf << '"' << complete_enum(<%= enum_constant type.name %>, <%= lit type.name %>, value) << '"'
<%- when :object -%>
    when <%= i %>
      node = [path, key, nullable, @segment, @buf.bytesize, nil]
      <%= execute_method type.name %> value, nodes, node
      node[5] = @buf.bytesize
<%- else -%>
    when <%= i %>
      resolved = @resolvers.resolve_type_<%= type.name %>(value, @context)
      node = [path, key, nullable, @segment, @buf.bytesize, nil]
      execute_abstract <%= lit type.name %>, resolved, value, nodes, node
      node[5] = @buf.bytesize
<%- end -%>
<%- end -%>
    end
  end
<%- unless abstract_types.empty? -%>

  # Executes an object of `type`, the object type an interface or union
  # resolved to
  #: (String, String, untyped, Array[TinyGQL::Nodes::Field], path) -> void
  def execute_abstract abstract, type, value, nodes, path
    unless type.is_a?(String) && fragment_applies?(abstract, type)
      raise TinyGQL::ExecutionError, "Abstract type #{abstract} must resolve to one of its object types, got #{type.inspect}"
    end

    case OBJECT_BITS[type]
<%- object_bits.each do |name, i| -%>
    when <%= i %> then <%= execute_method name %> value, nodes, path
<%- end -%>
    else
      raise TinyGQL::ExecutionError, "Abstract type #{abstract} must resolve to one of its object types, got #{type.inspect}"
    end
  end
<%- end -%>
<%- object_types.each do |type| -%>

  #: (untyped, Array[TinyGQL::Nodes::Field | TinyGQL::Nodes::OperationDefinition], path?) -> void
  def <%= execute_method type.name %> obj, nodes, path
    collected = collect_fields <%= lit type.name %>, nodes
    buf = @buf
    i = 0
    while i < collected.length
      buf << collected[i + 2]
      <%= execute_field_method type.name %> obj, collected[i + 1], path, collected[i]
<%- if type.name == schema.roots["mutation"] -%>
      # Mutation fields run one at a time, Lazies and all
      drain
<%- end -%>
      i += 3
    end
    buf << (i == 0 ? "{}" : "}")
  end

  #: (untyped, Array[TinyGQL::Nodes::Field], path?, String) -> void
  def <%= execute_field_method type.name %> obj, nodes, path, key
    start = @buf.bytesize
    type = nil
    case <%= execute_fields_constant type.name %>[nodes[0].name]
<%- selectable_fields(type).each_with_index do |field, i| -%>
    when <%= i %> # <%= field.name %>
<%- if field.name == "__typename" -%>
      @buf << <%= lit JSON.generate(type.name) %>
<%- else -%>
      type = <%= field_type_constant field.type %>
      value = @resolvers.<%= resolver_method type.name, field.name %>(obj, <%= field.arguments.empty? ? "nil" : "#{field_arguments_method type, field}(nodes[0])" %>, @context)
      complete_value type, nodes, value, path, key
<%- end -%>
<%- end -%>
    end
  rescue TinyGQL::ExecutionError, TinyGQL::Scalars::InvalidValue => e
    field_error e, type, path, key, start
  end
<%- end -%>
<%- @field_arguments.each do |field, (method, type)| -%>
<%- arguments = field.arguments -%>

  #: (TinyGQL::Nodes::Field) -> <%= arguments_class type.name, field.name %>
  def <%= method %> field
<%- arguments.each_index do |i| -%>
    f<%= i %> = TinyGQL::Inputs::UNDEFINED
<%- end -%>
    nodes = field.arguments
    if nodes
      i = 0
      while i < nodes.length
        node = nodes[i]
        name = node.name
        case name
<%- arguments.each_with_index do |arg, i| -%>
        when <%= lit arg.name %> then f<%= i %> = argument_value name, <%= type_constant arg.type %>, node.value
<%- end -%>
        end
        i += 1
      end
    end
    # Arguments whose variables are missing get their defaults
<%- arguments.each_with_index do |arg, i| -%>
    f<%= i %> = <%= arg.default_value ? default_code(arg.type, arg.default_value) : "nil" %> if TinyGQL::Inputs::UNDEFINED.equal?(f<%= i %>)
<%- end -%>
    <%= arguments_class type.name, field.name %>.new(<%= arguments.each_index.map { "f#{_1}" }.join(", ") %>)
  end
<%- end -%>
end
