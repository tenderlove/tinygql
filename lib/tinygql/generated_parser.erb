# Bit positions for object types that belong to an interface or union.
# Other object types can only overlap with themselves, so they don't need one
<%- if object_bits.empty? -%>
OBJECT_BITS = {}.freeze #: Hash[String, Integer]
<%- else -%>
OBJECT_BITS = {
<%- object_bits.each do |name, bit| -%>
  <%= lit name %> => <%= bit %>,
<%- end -%>
}.freeze #: Hash[String, Integer]
<%- end -%>

# Bitmaps of the object types each interface and union could be, using the
# positions in OBJECT_BITS
<%- if abstract_types.empty? -%>
ABSTRACT_POSSIBLE_TYPES = {}.freeze #: Hash[String, Integer]
<%- else -%>
ABSTRACT_POSSIBLE_TYPES = {
<%- abstract_types.each do |type| -%>
  <%= lit type.name %> => <%= possible_types_bitmap type.name %>,
<%- end -%>
}.freeze #: Hash[String, Integer]
<%- end -%>

# Types that variables can be declared with, mapped to branches in
# named_value
INPUT_TYPES = {
<%- input_types.each_with_index do |type, i| -%>
  <%= lit type.name %> => <%= i %>,
<%- end -%>
}.freeze #: Hash[String, Integer]

# Maps composite type names to branches in composite_selection_set
COMPOSITE_TYPES = {
<%- composite_types.each_with_index do |type, i| -%>
  <%= lit type.name %> => <%= i %>,
<%- end -%>
}.freeze #: Hash[String, Integer]

# Each type's field names map to branch numbers in its field_for_* method.
# Dispatching on an Integer is faster than `case` with String keys, which
# YJIT compiles to a comparison against each key in turn.
<%- composite_types.each_with_index do |type, i| -%>
<%- simple, other = selectable_fields(type).partition { |f| f.arguments.empty? && !composite?(f.type_name) } -%>
<%- if i > 0 -%>

<%- end -%>
<%= fields_constant type.name %> = {
<%- simple.each do |field| -%>
  <%= lit field.name %> => 0,
<%- end -%>
<%- other.each_with_index do |field, i| -%>
  <%= lit field.name %> => <%= i + 1 %>,
<%- end -%>
}.freeze #: Hash[String, Integer]
<%- end -%>

# The type of each field of each composite type, for checking that fields
# with the same response key can merge
<%- field_types = composite_types.map { |type| [type.name, selectable_fields(type).map { |field| [field.name, field_type_constant(field.type)] }] } -%>
<%- @field_types.each_value do |constant, type| -%>
<%= constant %> = <%= type_node type %> #: <%= type.class.name %>
<%- end -%>

FIELD_TYPES = {
<%- field_types.each do |type_name, fields| -%>
  <%= lit type_name %> => {
<%- fields.each do |name, constant| -%>
    <%= lit name %> => <%= constant %>,
<%- end -%>
  }.freeze,
<%- end -%>
}.freeze #: Hash[String, Hash[String, TinyGQL::Nodes::NamedType | TinyGQL::Nodes::ListType | TinyGQL::Nodes::NotNullType]]

# Maps directive names to branches in schema_directive
DIRECTIVES = {
<%- schema.directives.each_value.with_index do |directive, i| -%>
  <%= lit directive.name %> => <%= i %>,
<%- end -%>
}.freeze #: Hash[String, Integer]

# Directives that can be used more than once in the same location
REPEATABLE_DIRECTIVES = {
<%- schema.directives.each_value.select(&:repeatable).each do |directive| -%>
  <%= lit directive.name %> => true,
<%- end -%>
}.freeze #: Hash[String, true]

private

#: (String) -> bool
def repeatable_directive? name
  REPEATABLE_DIRECTIVES.key?(name)
end

# Parses a directive at `location`, whose bit in DIRECTIVE_LOCATION_BITS is
# `bit`
#: (Integer, Symbol) -> TinyGQL::Nodes::Directive
def schema_directive bit, location
  loc = pos
  expect_token :DIR_SIGN
  name = self.name
  case DIRECTIVES[name]
<%- schema.directives.each_value.with_index do |directive, i| -%>
  when <%= i %> # @<%= directive.name %>
    misplaced_directive! name, location, loc if <%= directive_location_bits directive %> & bit == 0
<%- end -%>
  else
    unknown_directive! name, loc
  end
  arguments = if at?(:LPAREN); self.arguments; end
  TinyGQL::Nodes::Directive.new(loc, name, arguments)
end

#: (String) -> bool
def composite_type? type
  COMPOSITE_TYPES.key?(type)
end

#: (String) -> Integer?
def object_bit type
  OBJECT_BITS[type]
end

#: (String) -> Integer?
def abstract_possible_types type
  ABSTRACT_POSSIBLE_TYPES[type]
end

#: (String, String) -> (TinyGQL::Nodes::NamedType | TinyGQL::Nodes::ListType | TinyGQL::Nodes::NotNullType)
def field_type parent, name
  FIELD_TYPES[parent][name]
end

#: (String) -> bool
def input_type? type
  INPUT_TYPES.key?(type)
end

# Parses a constant value of the input type named `type`, for variable
# defaults
#: (String) -> (TinyGQL::Nodes::Value | TinyGQL::Nodes::ObjectValue | TinyGQL::Nodes::Variable)
def named_value type
  case INPUT_TYPES[type]
<%- input_types.each_with_index do |type, i| -%>
  when <%= i %> then <%= value_method TinyGQL::Nodes::NamedType.new(0, type.name) %>(true)
<%- end -%>
  end
end

#: (String?) -> Array[TinyGQL::Nodes::Field | TinyGQL::Nodes::InlineFragment | TinyGQL::Nodes::FragmentSpread]
def operation_selection_set type
  case type
  when nil, "query" then <%= selection_set_method schema.roots["query"] %>
<%- %w{ mutation subscription }.each do |op| -%>
<%- if schema.roots[op] -%>
  when <%= lit op %> then <%= selection_set_method schema.roots[op] %>
<%- end -%>
<%- end -%>
  else
    unsupported_operation! type
  end
end

# Call sites stay monomorphic for the JIT, unlike dispatching with `send`
#: (String, Integer) -> Array[TinyGQL::Nodes::Field | TinyGQL::Nodes::InlineFragment | TinyGQL::Nodes::FragmentSpread]
def composite_selection_set type, loc
  case COMPOSITE_TYPES[type]
<%- composite_types.each_with_index do |type, i| -%>
  when <%= i %> then <%= selection_set_method type.name %>
<%- end -%>
  else
    unknown_type! type, loc
  end
end
<%- composite_types.each do |type| -%>

#: () -> Array[TinyGQL::Nodes::Field | TinyGQL::Nodes::InlineFragment | TinyGQL::Nodes::FragmentSpread]
def <%= selection_set_method type.name %>
  expect_token :LCURLY
  list = []
  while !at?(:RCURLY)
    list << if at?(:ELLIPSIS)
      schema_selection_fragment <%= lit type.name %>
    else
      <%= field_method type.name %>
    end
  end
  expect_token :RCURLY
  list.freeze
end

#: () -> TinyGQL::Nodes::Field
def <%= field_method type.name %>
  loc = pos
  name = self.name
  aliaz = nil

  if at?(:COLON)
    accept_token
    aliaz = name
    name = self.name
  end

  case <%= fields_constant type.name %>[name]
<%- simple, other = selectable_fields(type).partition { |f| f.arguments.empty? && !composite?(f.type_name) } -%>
  when 0 # <%= simple.map(&:name).join(", ") %>
    return leaf_field(loc, aliaz, name, <%= lit type.name %>)
<%- other.each_with_index do |field, i| -%>
  when <%= i + 1 %> # <%= field.name %>
<%- if field.arguments.empty? -%>
    no_arguments! name, <%= lit type.name %>
    arguments = nil
<%- else -%>
<%- required = field.arguments.find(&:required) -%>
    arguments = if at?(:LPAREN)
      <%= argument_method type, field %> loc
<%- if required -%>
    else
      missing_argument! <%= lit required.name %>, name, <%= lit type.name %>, loc
<%- end -%>
    end
<%- end -%>
    directives = if at?(:DIR_SIGN); self.directives :FIELD; end
<%- if composite?(field.type_name) -%>
    missing_selection_set! name, <%= lit type.name %>, loc unless at?(:LCURLY)
    selection_set = <%= selection_set_method field.type_name %>
<%- else -%>
    leaf_selection_set! name, <%= lit type.name %>, loc if at?(:LCURLY)
    selection_set = nil
<%- end -%>
<%- end -%>
  else
    unknown_field! name, <%= lit type.name %>, loc
  end

  TinyGQL::Nodes::Field.new(loc, aliaz, name, arguments, directives, selection_set, <%= lit type.name %>)
end
<%- end -%>
<%- @argument_methods.each do |method, type, field| -%>

# Arguments for <%= type.name %>.<%= field.name %>
#: (Integer) -> Array[TinyGQL::Nodes::Argument]
def <%= method %> field_loc
  expect_token :LPAREN
<%- field.arguments.each_index do |i| -%>
  seen_<%= i %> = false
<%- end -%>
  args = []
  while !at?(:RPAREN)
    loc = pos
    name = self.name
    expect_token :COLON
    case name
<%- field.arguments.each_with_index do |arg, i| -%>
    when <%= lit arg.name %>
      duplicate_argument! name, <%= lit field.name %>, <%= lit type.name %>, loc if seen_<%= i %>
      seen_<%= i %> = true
      value = <%= input_value arg, "false" %>
<%- end -%>
    else
      unknown_argument! name, <%= lit field.name %>, <%= lit type.name %>, loc
    end
    args << TinyGQL::Nodes::Argument.new(loc, name, value)
  end
  expect_token :RPAREN
<%- field.arguments.each_with_index do |arg, i| -%>
<%- next unless arg.required -%>
  missing_argument! <%= lit arg.name %>, <%= lit field.name %>, <%= lit type.name %>, field_loc unless seen_<%= i %>
<%- end -%>
  args.freeze
rescue TinyGQL::Scalars::InvalidValue => e
  invalid_argument! name, <%= lit field.name %>, <%= lit type.name %>, e.message, loc
end
<%- end -%>
<%- @value_methods.each_value do |method, type| -%>

<%= type_constant type %> = <%= type_node type %> #: <%= type.class.name %>

# Parses a value of type <%= Schema.type_string(type) %>
# Variables aren't allowed when `const` is true
#: (bool) -> (TinyGQL::Nodes::Value | TinyGQL::Nodes::ObjectValue | TinyGQL::Nodes::Variable)
def <%= method %> const
<%- if type.not_null_type? -%>
  case token_name
  when :VAR_SIGN then variable_usage <%= type_constant type %>, const
  when :NULL then null_value! <%= lit Schema.type_string(type) %>
  else <%= value_method type.type %> const
  end
<%- else -%>
  case token_name
  when :VAR_SIGN then variable_usage <%= type_constant type %>, const
  when :NULL then null_value
<%- if type.list_type? -%>
  when :LBRACKET
    loc = pos
    accept_token
    items = []
    while !at?(:RBRACKET)
      items << <%= value_method type.type %>(const)
    end
    accept_token
    TinyGQL::Nodes::ListValue.new(loc, items.freeze, nil)
  else
    # A single value where a list is expected is a list of one
    <%= value_method type.type %> const
  end
<%- else -%>
<%- named = schema[type.name] -%>
<%- case named.kind -%>
<%- when :scalar -%>
<%- if (literals = BUILTIN_LITERALS[named.name]) -%>
<%- literals.each do |token, node_class| -%>
  when <%= token.map { ":#{_1}" }.join(", ") %>
    loc = pos
    text = <%= token == [:STRING] ? "expect_string_value" : "expect_token_value(token_name)" %>
    TinyGQL::Nodes::<%= node_class %>.new(loc, text, @scalars.coerce_literal_<%= named.name %>(text).freeze)
<%- end -%>
  else
    invalid_literal! <%= lit named.name %>, self.value
  end
<%- else -%>
  else
    loc = pos
    kind = custom_literal_kind
    text = custom_literal_text kind, <%= lit named.name %>
    custom_literal loc, kind, text, @scalars.coerce_literal_<%= named.name %>(kind, text)
  end
<%- end -%>
<%- when :enum -%>
  when :IDENTIFIER, *ENUM_VALUE_KEYWORD_TOKENS
    loc = pos
    text = expect_token_value(token_name)
    unknown_enum_value! <%= lit named.name %>, text unless <%= enum_constant named.name %>.key?(text)
    TinyGQL::Nodes::EnumValue.new(loc, text, text)
  else
    invalid_enum! <%= lit named.name %>, self.value
  end
<%- else -%>
  when :LCURLY
    <%= object_method named.name %> const
  else
    unexpected_value! <%= lit named.name %>, self.value
  end
<%- end -%>
<%- end -%>
<%- end -%>
end
<%- end -%>
<%- @object_methods.each_value do |method, named| -%>
<%- fields = named.fields.values -%>

# Parses an object value of input type <%= named.name %>
#: (bool) -> TinyGQL::Nodes::ObjectValue
def <%= method %> const
  loc = pos
  expect_token :LCURLY
<%- fields.each_index do |i| -%>
  seen_<%= i %> = false
<%- end -%>
  fields = []
  while !at?(:RCURLY)
    field_loc = pos
    name = self.name
    expect_token :COLON
    case name
<%- fields.each_with_index do |field, i| -%>
    when <%= lit field.name %>
      duplicate_input_field! name if seen_<%= i %>
      seen_<%= i %> = true
      value = <%= input_value field, "const" %>
<%- end -%>
    else
      unknown_input_field! name, <%= lit named.name %>
    end
    fields << TinyGQL::Nodes::ObjectField.new(field_loc, name, value)
  end
  accept_token
<%- fields.each_with_index do |field, i| -%>
<%- next unless field.required -%>
  missing_input_field! <%= lit field.name %>, <%= lit named.name %>, <%= lit Schema.type_string(field.type) %> unless seen_<%= i %>
<%- end -%>
  TinyGQL::Nodes::ObjectValue.new(loc, fields.freeze, nil)
end
<%- end -%>
<%- input_enums.each do |enum| -%>

<%= enum_constant enum.name %> = {
<%- enum.values.each_key do |value| -%>
  <%= lit value %> => true,
<%- end -%>
}.freeze #: Hash[String, true]
<%- end -%>
<%- if custom_scalars.any? -%>

# Coerces the schema's scalars.  Built in scalars follow the GraphQL spec,
# and custom scalars raise NotImplementedError until you implement them.
# Subclass this and pass an instance to `parse`, `coerce`, and `execute` with
# `scalars:`
class Scalars < TinyGQL::Scalars
<%- custom_scalars.each_with_index do |scalar, i| -%>
<%- if i > 0 -%>

<%- end -%>
  #: (Symbol, String | TinyGQL::Nodes::ListValue | TinyGQL::Nodes::ObjectValue) -> untyped
  def coerce_literal_<%= scalar.name %> kind, text
    raise NotImplementedError, "#{self.class}#coerce_literal_<%= scalar.name %> is not implemented"
  end

  #: (untyped) -> untyped
  def coerce_value_<%= scalar.name %> value
    raise NotImplementedError, "#{self.class}#coerce_value_<%= scalar.name %> is not implemented"
  end

  #: (untyped) -> untyped
  def coerce_result_<%= scalar.name %> value
    raise NotImplementedError, "#{self.class}#coerce_result_<%= scalar.name %> is not implemented"
  end
<%- end -%>
end
<%- else -%>

# Coerces the schema's scalars.  Subclass this and pass an instance to
# `parse`, `coerce`, and `execute` with `scalars:` to change how they're
# coerced
class Scalars < TinyGQL::Scalars
end
<%- end -%>

<%- unless input_objects.empty? -%>
# Input object values, frozen, with a reader for each field.  Missing
# fields without defaults are nil
module InputObjects
<%- input_objects.each_with_index do |type, i| -%>
<%- if i > 0 -%>

<%- end -%>
<%= value_class type.name, type.fields.values, "  " %>
<%- end -%>
end

<%- end -%>
# Coerces the schema's input types.  See TinyGQL::Inputs
class Inputs < TinyGQL::Inputs
  private

  #: (String, untyped) -> untyped
  def coerce_named type, value
    case INPUT_TYPES[type]
<%- input_types.each_with_index do |type, i| -%>
<%- case type.kind -%>
<%- when :scalar -%>
    when <%= i %> then @scalars.coerce_value_<%= type.name %>(value)
<%- when :enum -%>
    when <%= i %> then coerce_enum <%= enum_constant type.name %>, <%= lit type.name %>, value
<%- else -%>
    when <%= i %> then <%= coerce_object_method type.name %> value
<%- end -%>
<%- end -%>
    end
  end

  # Scalar and enum literals were coerced when they were parsed
  #: (String, TinyGQL::Nodes::Value | TinyGQL::Nodes::ObjectValue | TinyGQL::Nodes::Variable, Array[untyped]) -> untyped
  def literal_named type, node, variables
<%- if input_objects.empty? -%>
    node.coerced
<%- else -%>
    case INPUT_TYPES[type]
<%- input_types.each_with_index do |type, i| -%>
<%- next unless type.kind == :input -%>
    when <%= i %> then <%= literal_object_method type.name %> node, variables
<%- end -%>
    else node.coerced
    end
<%- end -%>
  end
<%- input_objects.each do |type| -%>
<%- fields = type.fields.values -%>

  #: (untyped) -> <%= input_class type.name %>
  def <%= coerce_object_method type.name %> value
    input_object! <%= lit type.name %>, value
    keys = value.keys
    i = 0
    while i < keys.length
      case keys[i]
      when <%= fields.map { lit _1.name }.join(", ") %>
      else unknown_input_field! keys[i], <%= lit type.name %>
      end
      i += 1
    end

<%- fields.each_with_index do |field, i| -%>
    f<%= i %> = if value.key?(<%= lit field.name %>)
      coerce_field <%= type_constant field.type %>, value[<%= lit field.name %>], <%= lit field.name %>
<%- if field.default_value -%>
    else
      <%= default_code field.type, field.default_value %>
<%- elsif field.required -%>
    else
      missing_input_field! <%= lit field.name %>, <%= lit type.name %>, <%= lit Schema.type_string(field.type) %>
<%- end -%>
    end
<%- end -%>
    <%= input_class type.name %>.new(<%= fields.each_index.map { "f#{_1}" }.join(", ") %>)
  end

  #: (TinyGQL::Nodes::ObjectValue, Array[untyped]) -> <%= input_class type.name %>
  def <%= literal_object_method type.name %> node, variables
<%- fields.each_index do |i| -%>
    f<%= i %> = UNDEFINED
<%- end -%>
    values = node.values
    i = 0
    while i < values.length
      field = values[i]
      case field.name
<%- fields.each_with_index do |field, i| -%>
      when <%= lit field.name %> then f<%= i %> = literal_field <%= type_constant field.type %>, field.value, variables
<%- end -%>
      end
      i += 1
    end
    # Missing variables are like missing fields
<%- fields.each_with_index do |field, i| -%>
    f<%= i %> = <%= field.default_value ? default_code(field.type, field.default_value) : "nil" %> if UNDEFINED.equal?(f<%= i %>)
<%- end -%>
    <%= input_class type.name %>.new(<%= fields.each_index.map { "f#{_1}" }.join(", ") %>)
  end
<%- end -%>
end
